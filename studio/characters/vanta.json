{
  "id": "vanta",
  "name": "VANTA",
  "tagline": "Blown-out 808s, screaming synths, no brakes.",
  "description": "A restless figure in a matte-black hood with a cracked red visor. Plays everything loud on purpose: clipped 808s, wide detuned leads and fast hat rolls.",
  "visual": {
    "palette": [
      "#0b0b10",
      "#ff2a4d",
      "#ff8a3d"
    ],
    "emblem": "visor",
    "appearance": "matte-black hood, cracked red visor, ember sparks"
  },
  "genre": "trap",
  "subgenre": "rage",
  "tempo": {
    "min": 150,
    "max": 168,
    "default": 160,
    "feel": "half"
  },
  "swing": 0.0,
  "keys": {
    "preferred_scales": [
      "minor",
      "phrygian",
      "harmonic_minor"
    ],
    "preferred_roots": [
      "C#",
      "F",
      "G#",
      "A#"
    ]
  },
  "drums": {
