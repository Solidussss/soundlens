        5,
        6
      ],
      [
        0,
        3,
        5,
        4
      ]
    ],
    "rhythm": "sustain",
    "register": [
      52,
      68
    ]
  },
  "extra": [
    {
      "role": "atmosphere",
      "preset": "atmos_dark",
      "gain_db": -10
