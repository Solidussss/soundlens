      {
        "type": "distortion",
        "params": {
          "drive_db": 14,
          "mode": "hard",
          "keep_sub_hz": 70,
          "tone_hz": 6000
        }
      }
    ]
  },
  "melody": {
    "preset": "rage_lead",
    "register": [
      70,
      86
    ],
    "density": 0.75,
    "motif_bars": 1,
